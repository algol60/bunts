{
  "name": "opencode-webfetch-mcp",
  "version": "1.1.0",
  "description": "A drop-in MCP replacement for OpenCode's webfetch tool",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencode-webfetch-mcp": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts --stdio",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile dist/opencode-webfetch-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "htmlparser2": "^12.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.9.3"
  }
}
