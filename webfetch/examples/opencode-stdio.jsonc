{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "web": {
        "type": "local",
        "command": ["/home/frogger/webfetch/dist/opencode-webfetch-mcp", "--stdio"],
        "codemode": false
      }
    }
  },
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "web_webfetch", "resource": "*", "effect": "allow" }
  ]
}
