{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "web": {
        "type": "remote",
        "url": "http://127.0.0.1:3000/mcp",
        "oauth": false,
        "codemode": false
      }
    }
  },
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "web_webfetch", "resource": "*", "effect": "allow" }
  ]
}
