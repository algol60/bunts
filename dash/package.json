{
  "name": "opencode-dashboard",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "opencode-dashboard": "src/index.ts"
  },
  "files": [
    "public",
    "src"
  ],
  "scripts": {
    "build": "bun build src/frontend.ts --outfile public/app.js --minify",
    "dev": "bun run build && bun run --watch src/index.ts",
    "start": "bun run build && bun run src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "chart.js": "^4.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
